rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administradores: o dono + os e-mails em config/main.editores
    function isEditor() {
      return request.auth != null && (
        request.auth.token.email in ['guilhermecastiglionii@gmail.com'] ||
        (exists(/databases/$(database)/documents/config/main) &&
         request.auth.token.email in get(/databases/$(database)/documents/config/main).data.get('editores', []))
      );
    }
    match /{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
